# =============================================================================
# Modelo de variáveis de ambiente — copie para .env e preencha com valores reais
# NUNCA commit o arquivo .env (já está no .gitignore)
# =============================================================================

# --- AWS (apenas Bedrock; credenciais do IAM) ---
# Necessário para embeddings (Titan) e LLM (DeepSeek)
# Na EC2, prefira IAM Role (instance profile) em vez de access keys no .env:
# basta deixar AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY vazios e a SDK
# assume as credenciais da própria instância.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- AWS Bedrock (modelos usados no projeto) ---
# Embeddings: Amazon Titan Text Embeddings V2 (1024 dimensões)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# LLM: DeepSeek-R1 (cross-region inference profile US)
BEDROCK_LLM_MODEL=us.deepseek.r1-v1:0

# --- PostgreSQL + pgvector ---
# local: localhost; docker compose: postgres
# AWS RDS: preencha POSTGRES_HOST com o endpoint da instância (ex.: rag.cxxxxx.us-east-1.rds.amazonaws.com)
# e POSTGRES_PORT=5432. O banco (POSTGRES_DB) e o usuário devem ser criados no RDS.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Aplicação ---
# URL da API usada pelo frontend Streamlit.
# local: http://localhost:8000; docker compose: http://fastapi:8000; EC2: http://localhost:8000
API_URL=http://localhost:8000
# Opcional: se preferir definir a URL completa do banco diretamente
# DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag